# Supabase (get from https://supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Solana RPC (Helius recommended: https://helius.dev)
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_API_KEY=YOUR_HELIUS_KEY

# Admin wallet (the Solana wallet that controls the admin dashboard)
PLATFORM_ADMIN_WALLET=YourSolanaPublicKeyHere

# Optional: PumpPortal API for token creation
# If not set, app falls back to manual launch mode
PUMPPORTAL_API_KEY=

# Optional: Kick API for live stream status checks
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Site URL (used in verification phrases and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
